    },
    {
      "parameters": {
        "jsCode": "// O formulário entrega todos os PDFs num único item (Documentos_0, Documentos_1, &&.).\n// Aqui cada arquivo vira um item, com o binário em \"data\" e o nome do arquivo no JSON.\n  \nconst saida = [];\nfor (const item of $input.all()) {\nfor (const chave of Object.keys(item.binary ?? {})) {\nconst arquivo = item.binary[chave];\nsaida.push({ json: { arquivo: arquivo.fileName }, binary: { data: \narquivo } });\n}\n}\nreturn saida;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
